         className,
       )}
-      style={mode === "fill" ? inset : undefined}
+      style={
+        mode === "fill"
+          ? insetFill
+          : mode === "bleed"
+            ? bleedStyle
+            : undefined
+      }
     >
       {children}
     </main>
