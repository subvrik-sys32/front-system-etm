+  taskId?: string | null
+  projectId?: string | null
+  /** Fuente de verdad del asset: foto de proyecto vs de tarea. */
+  scope?: EntityFocusScope
 }): string | null {
   const params = new URLSearchParams()
   params.set("focus", crypto.randomUUID())
 
+  const scope =
+    opts.scope ??
