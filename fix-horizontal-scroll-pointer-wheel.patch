 "use client"
 
-import type { PropsWithChildren } from "react"
+import {
+  useCallback,
+  useEffect,
+  useRef,
+  type PointerEvent,
+  type PropsWithChildren,
+} from "react"
 
-import { ScrollArea } from "@/components/ui/scroll-area"
 import { cn } from "@/shared/utils/utils"
 
 type Props = PropsWithChildren<{ className?: string }>
 
+/** Píxeles antes de reclamar el gesto (click en card sigue siendo click). */
+const DRAG_THRESHOLD_PX = 6
+
+/**
+ * Carrusel horizontal embebido en scroll vertical de página.
+ *
+ * Responsabilidad de este componente (no de ScrollArea / AppListScroll):
+ * - Touch: overflow-x nativo (sin lock del eje Y del padre).
+ * - Mouse drag: pointer + umbral.
+ * - Rueda: delta → scrollLeft; en el borde no consume el evento
+ *   (el padre vertical sigue funcionando).
+ */
 export function HorizontalScroll({ children, className }: Props) {
+  const ref = useRef<HTMLDivElement>(null)
+  const dragRef = useRef<{
+    pointerId: number
+    startX: number
+    originScroll: number
+    dragging: boolean
+  } | null>(null)
+
+  // wheel no-passive: React onWheel es passive y no permite preventDefault.
+  useEffect(() => {
+    const el = ref.current
+    if (!el) return
+
+    const onWheel = (e: WheelEvent) => {
+      if (el.scrollWidth <= el.clientWidth) return
+
+      const delta = e.deltaX !== 0 ? e.deltaX : e.deltaY
+      if (delta === 0) return
+
+      const max = el.scrollWidth - el.clientWidth
+      const prev = el.scrollLeft
+      const next = Math.min(max, Math.max(0, prev + delta))
+
+      if (next === prev) return // borde → padre vertical
+
+      el.scrollLeft = next
+      e.preventDefault()
+    }
+
+    el.addEventListener("wheel", onWheel, { passive: false })
+    return () => el.removeEventListener("wheel", onWheel)
+  }, [])
+
+  const onPointerDown = useCallback((e: PointerEvent<HTMLDivElement>) => {
+    if (e.button !== 0) return
+    const el = ref.current
+    if (!el || el.scrollWidth <= el.clientWidth) return
+
+    dragRef.current = {
+      pointerId: e.pointerId,
+      startX: e.clientX,
+      originScroll: el.scrollLeft,
+      dragging: false,
+    }
+  }, [])
+
+  const onPointerMove = useCallback((e: PointerEvent<HTMLDivElement>) => {
+    const state = dragRef.current
+    const el = ref.current
+    if (!state || state.pointerId !== e.pointerId || !el) return
+
+    const dx = e.clientX - state.startX
+    if (!state.dragging) {
+      if (Math.abs(dx) < DRAG_THRESHOLD_PX) return
+      state.dragging = true
+      el.setPointerCapture(e.pointerId)
+      el.dataset.dragging = "true"
+    }
+
+    el.scrollLeft = state.originScroll - dx
+  }, [])
+
+  const endDrag = useCallback((e: PointerEvent<HTMLDivElement>) => {
+    const state = dragRef.current
+    const el = ref.current
+    if (!state || state.pointerId !== e.pointerId) return
+
+    if (state.dragging && el?.hasPointerCapture(e.pointerId)) {
+      el.releasePointerCapture(e.pointerId)
+    }
+    if (el) delete el.dataset.dragging
+    dragRef.current = null
+  }, [])
+
   return (
-    <ScrollArea orientation="horizontal" className="h-full min-h-0 w-full">
-      <div className={cn("flex h-full min-h-0 w-max items-start gap-3", className)}>
+    <div
+      ref={ref}
+      data-slot="horizontal-scroll"
+      onPointerDown={onPointerDown}
+      onPointerMove={onPointerMove}
+      onPointerUp={endDrag}
+      onPointerCancel={endDrag}
+      className={cn(
+        "relative min-h-0 min-w-0 w-full cursor-grab overflow-x-auto overscroll-x-contain",
+        "data-[dragging=true]:cursor-grabbing data-[dragging=true]:select-none",
+        "[scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden",
+      )}
+    >
+      <div className={cn("flex w-max items-start gap-3", className)}>
         {children}
       </div>
-    </ScrollArea>
+    </div>
   )
 }
