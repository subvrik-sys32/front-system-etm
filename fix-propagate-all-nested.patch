+    if (task.materialLines?.some(l => l.thickness?.id === thickness.id)) {
+      next = {
+        ...next,
+        materialLines: task.materialLines!.map(line =>
+          line.thickness?.id === thickness.id
+            ? { ...line, thickness: { ...line.thickness, ...thickness } }
+            : line,
+        ),
+      }
+    }
+    return next
+  })
+}
